<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0"/>
<title>JM Skills Academy</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=Cormorant+Garamond:wght@300;600&family=Lato:wght@300;400;700&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0;}
:root{
  --gold:#c9a84c;--gold-light:#e8c97a;--dark:#0a0a0a;
  --text:#f0e9d6;--text-dim:rgba(240,233,214,0.65);--text-faint:rgba(240,233,214,0.4);
  --border:rgba(201,168,76,0.18);--border-bright:rgba(201,168,76,0.35);
}
body{background:var(--dark);color:var(--text);font-family:'Lato',sans-serif;line-height:1.6;font-size:15px;-webkit-font-smoothing:antialiased;}
.wrap{max-width:430px;margin:0 auto;}
#loading{position:fixed;inset:0;background:var(--dark);z-index:999;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;}
.load-logo{font-family:'Playfair Display',serif;font-size:1.2rem;letter-spacing:3px;color:var(--gold);text-transform:uppercase;}
.load-bar{width:120px;height:1px;background:rgba(201,168,76,0.2);position:relative;overflow:hidden;}
.load-bar::after{content:'';position:absolute;top:0;left:-100%;width:100%;height:100%;background:var(--gold);animation:loadslide 1.2s ease-in-out infinite;}
@keyframes loadslide{to{left:100%;}}
.load-sub{font-size:0.65rem;letter-spacing:3px;text-transform:uppercase;color:var(--text-faint);}
.banner-wrap{position:relative;width:100%;overflow:hidden;height:200px;background:#111;}
.banner-wrap img{width:100%;height:100%;object-fit:cover;object-position:center 20%;}
.banner-overlay{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(10,10,10,0.05) 0%,rgba(10,10,10,0.65) 80%,var(--dark) 100%);}
.banner-logo{position:absolute;bottom:14px;left:0;right:0;text-align:center;}
.banner-logo-text{font-family:'Playfair Display',serif;font-size:1.05rem;font-weight:700;letter-spacing:3px;color:var(--gold);text-transform:uppercase;}
.banner-logo-sub{font-family:'Cormorant Garamond',serif;font-size:0.75rem;font-weight:300;color:rgba(240,233,214,0.55);letter-spacing:2px;display:block;margin-top:2px;}
.banner-placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#111 0%,#1a1506 100%);}
.banner-placeholder span{font-family:'Playfair Display',serif;font-size:1.4rem;color:var(--gold);letter-spacing:3px;text-transform:uppercase;}
.nav{background:rgba(10,10,10,0.97);border-bottom:1px solid var(--border);padding:0.7rem 1.2rem;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;backdrop-filter:blur(8px);}
.nav-logo{font-family:'Playfair Display',serif;font-size:0.85rem;font-weight:700;color:var(--gold);letter-spacing:1.5px;text-transform:uppercase;}
.nav-btn{background:var(--gold);color:var(--dark);border:none;padding:0.45rem 1rem;font-family:'Lato',sans-serif;font-weight:700;font-size:0.68rem;letter-spacing:1.5px;text-transform:uppercase;border-radius:2px;cursor:pointer;}
.hero{padding:1.6rem 1.2rem 1.4rem;border-bottom:1px solid var(--border);}
.eyebrow{font-size:0.62rem;letter-spacing:4px;text-transform:uppercase;color:var(--gold);font-weight:300;margin-bottom:0.6rem;display:flex;align-items:center;gap:8px;}
.eyebrow::before,.eyebrow::after{content:'';display:inline-block;width:18px;height:1px;background:var(--gold);}
h1{font-family:'Playfair Display',serif;font-size:2.4rem;font-weight:700;line-height:1.05;color:var(--text);}
h1 em{display:block;font-style:italic;color:var(--gold);font-size:2rem;}
.hero-sub{font-family:'Cormorant Garamond',serif;font-size:1.05rem;font-weight:300;color:var(--text-dim);margin:0.9rem 0 1.2rem;}
.pills{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:1.3rem;}
.pill{border:1px solid var(--border-bright);color:var(--gold);padding:3px 11px;font-size:0.65rem;letter-spacing:1px;text-transform:uppercase;border-radius:20px;}
.btn-p{background:var(--gold);color:var(--dark);border:none;width:100%;padding:0.9rem;font-family:'Lato',sans-serif;font-weight:700;font-size:0.8rem;letter-spacing:2px;text-transform:uppercase;cursor:pointer;border-radius:2px;margin-bottom:0.6rem;}
.btn-g{background:transparent;color:var(--gold);border:1px solid rgba(201,168,76,0.45);width:100%;padding:0.75rem;font-family:'Lato',sans-serif;font-size:0.75rem;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;border-radius:2px;}
.stats{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:rgba(201,168,76,0.03);}
.stat{padding:0.9rem 0.3rem;text-align:center;border-right:1px solid var(--border);}
.stat:last-child{border-right:none;}
.sn{font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:700;color:var(--gold);display:block;line-height:1;}
.sl{font-size:0.55rem;letter-spacing:1px;text-transform:uppercase;color:var(--text-faint);font-weight:300;margin-top:3px;display:block;}
.sec{padding:2rem 1.2rem;}
.sec-hd{text-align:center;margin-bottom:1.6rem;}
.sec-eye{font-size:0.6rem;letter-spacing:4px;text-transform:uppercase;color:var(--gold);font-weight:300;display:block;margin-bottom:0.5rem;}
.sec-title{font-family:'Playfair Display',serif;font-size:1.7rem;font-weight:700;color:var(--text);line-height:1.2;}
.sec-title em{font-style:italic;color:var(--gold);}
.divider{width:36px;height:1px;background:var(--gold);margin:0.8rem auto 0;}
.mod-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.4rem;}
.mod-item{display:flex;flex-direction:column;}
.mod-img-wrap{width:100%;aspect-ratio:4/3;overflow:hidden;border-radius:4px;background:#111;position:relative;}
.mod-img-wrap img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.4s ease;}
.mod-item:hover .mod-img-wrap img{transform:scale(1.04);}
.mod-img-placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#141414,#1c1500);font-size:1.8rem;}
.mod-info{padding:0.6rem 0 0;}
.mod-t{font-family:'Cormorant Garamond',serif;font-size:1rem;font-weight:600;color:var(--gold);line-height:1.25;margin-bottom:0.2rem;}
.mod-d{font-size:0.72rem;color:rgba(240,233,214,0.5);font-weight:300;line-height:1.4;}
.bonus-sec{padding:2rem 1.2rem;background:rgba(201,168,76,0.025);border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
.bonus-list{list-style:none;margin-top:1.4rem;}
.bonus-list li{display:flex;align-items:flex-start;gap:10px;padding:0.65rem 0;border-bottom:1px solid rgba(201,168,76,0.07);font-size:0.82rem;color:rgba(240,233,214,0.75);}
.bc{color:var(--gold);flex-shrink:0;font-size:0.85rem;margin-top:1px;}
.instr{padding:2rem 1.2rem;border-top:1px solid var(--border);}
.instr-card{border:1px solid var(--border-bright);padding:1.5rem 1.2rem;background:rgba(201,168,76,0.025);}
.instr-card::before{content:'';display:block;width:36px;height:2px;background:var(--gold);margin-bottom:1.2rem;}
.instr-photo{width:80px;height:80px;border-radius:50%;object-fit:cover;border:2px solid var(--gold);display:block;margin-bottom:1rem;}
.instr-photo-placeholder{width:80px;height:80px;border-radius:50%;background:rgba(201,168,76,0.1);border:2px solid var(--border-bright);display:flex;align-items:center;justify-content:center;margin-bottom:1rem;font-size:1.5rem;}
.instr-name{font-family:'Playfair Display',serif;font-size:1.4rem;font-weight:700;color:var(--text);margin-bottom:0.15rem;}
.instr-role{font-size:0.68rem;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);font-weight:300;margin-bottom:1rem;line-height:1.5;}
.instr-bio{font-size:0.83rem;color:rgba(240,233,214,0.7);line-height:1.75;margin-bottom:0.7rem;}
.certs-label{font-size:0.6rem;letter-spacing:3px;text-transform:uppercase;color:var(--gold);font-weight:300;margin:1rem 0 0.6rem;display:block;}
.cert-tags{display:flex;flex-wrap:wrap;gap:6px;}
.ctag{border:1px solid var(--border);color:rgba(240,233,214,0.55);padding:3px 9px;font-size:0.65rem;letter-spacing:0.5px;border-radius:2px;}
.modes-grid{display:grid;grid-template-columns:1fr 1fr;gap:0.8rem;margin-top:1.4rem;}
.mode{text-align:center;padding:1.2rem 0.8rem;border:1px solid var(--border);}
.me{font-size:1.4rem;margin-bottom:0.4rem;display:block;}
.ml{font-family:'Cormorant Garamond',serif;font-size:0.9rem;font-weight:600;color:var(--gold);display:block;margin-bottom:0.15rem;}
.ms{font-size:0.7rem;color:var(--text-faint);font-weight:300;}
.pricing{padding:2rem 1.2rem;text-align:center;}
.price-card{border:1px solid var(--border-bright);padding:2rem 1.2rem;position:relative;background:rgba(201,168,76,0.025);margin-top:1.6rem;}
.price-card::before{content:'';position:absolute;top:-1px;left:25%;right:25%;height:2px;background:var(--gold);}
.pbadge{background:var(--gold);color:var(--dark);font-size:0.62rem;letter-spacing:2px;text-transform:uppercase;font-weight:700;padding:4px 12px;display:inline-block;margin-bottom:1.2rem;border-radius:2px;}
.pamt{font-family:'Playfair Display',serif;font-size:3.2rem;font-weight:700;color:var(--text);line-height:1;}
.pamt sup.curr{font-size:1.3rem;vertical-align:super;color:var(--gold);}
.pamt sup.cents{font-size:1.2rem;vertical-align:super;color:var(--gold-light);}
.pper{font-size:0.72rem;color:var(--text-faint);letter-spacing:1.5px;text-transform:uppercase;margin-top:0.3rem;}
.pdiv{width:28px;height:1px;background:rgba(201,168,76,0.3);margin:1.2rem auto;}
.pfeats{list-style:none;text-align:left;margin-bottom:1.6rem;}
.pfeats li{padding:0.4rem 0;font-size:0.8rem;color:rgba(240,233,214,0.7);display:flex;gap:8px;border-bottom:1px solid rgba(201,168,76,0.07);}
.pchk{color:var(--gold);flex-shrink:0;}
.guar{font-size:0.7rem;color:var(--text-faint);margin-top:0.9rem;}
.faq{padding:2rem 1.2rem;border-top:1px solid var(--border);}
.faq-item{border-bottom:1px solid var(--border);}
.faq-q{width:100%;background:none;border:none;color:var(--text);font-family:'Lato',sans-serif;font-size:0.85rem;font-weight:700;padding:1rem 0;text-align:left;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:12px;line-height:1.4;}
.faq-q .arr{color:var(--gold);font-size:1rem;flex-shrink:0;transition:transform 0.2s;}
.faq-q.open .arr{transform:rotate(45deg);}
.faq-a{font-size:0.8rem;color:rgba(240,233,214,0.65);line-height:1.65;padding-bottom:1rem;display:none;}
.faq-a.open{display:block;}
.footer{border-top:1px solid rgba(201,168,76,0.2);padding:1.8rem 1.2rem;text-align:center;background:rgba(0,0,0,0.5);}
.fl{font-family:'Playfair Display',serif;font-size:1.05rem;font-weight:700;color:var(--gold);letter-spacing:3px;text-transform:uppercase;}
.ft{font-family:'Cormorant Garamond',serif;font-size:0.8rem;font-weight:300;color:var(--text-faint);letter-spacing:1.5px;font-style:italic;margin-top:0.3rem;}
</style>
</head>
<body>

<div id="loading">
  <div class="load-logo">JM Skills Academy</div>
  <div class="load-bar"></div>
  <div class="load-sub">Cargando contenido...</div>
</div>

<div class="wrap" id="page" style="display:none;">

  <div class="banner-wrap" id="banner-wrap">
    <div class="banner-placeholder"><span id="banner-fallback-text">JM Skills Academy</span></div>
    <div class="banner-overlay"></div>
    <div class="banner-logo">
      <div class="banner-logo-text" id="banner-logo-display"></div>
      <span class="banner-logo-sub" id="banner-sub-display"></span>
    </div>
  </div>

  <nav class="nav">
    <div class="nav-logo" id="nav-logo">JM Skills</div>
    <button class="nav-btn" id="nav-btn" onclick="goTo('pricing-sec')">Unirme</button>
  </nav>

  <section class="hero">
    <div class="eyebrow" id="hero-eyebrow"></div>
    <h1><span id="hero-t1"></span><em id="hero-t2"></em></h1>
    <p class="hero-sub" id="hero-sub"></p>
    <div class="pills" id="pills-wrap"></div>
    <button class="btn-p" id="btn-main" onclick="goTo('pricing-sec')"></button>
    <button class="btn-g" id="btn-sec" onclick="goTo('modulos-sec')"></button>
  </section>

  <div class="stats">
    <div class="stat"><span class="sn" id="s1n"></span><span class="sl" id="s1l"></span></div>
    <div class="stat"><span class="sn" id="s2n"></span><span class="sl" id="s2l"></span></div>
    <div class="stat"><span class="sn" id="s3n"></span><span class="sl" id="s3l"></span></div>
    <div class="stat"><span class="sn" id="s4n"></span><span class="sl" id="s4l"></span></div>
  </div>

  <section class="sec" id="modulos-sec">
    <div class="sec-hd">
      <span class="sec-eye" id="mod-eye"></span>
      <h2 class="sec-title"><span id="mod-t1"></span> <em id="mod-t2"></em></h2>
      <div class="divider"></div>
    </div>
    <div class="mod-grid" id="mod-grid"></div>
  </section>

  <section class="bonus-sec">
    <div class="sec-hd">
      <span class="sec-eye" id="rec-eye"></span>
      <h2 class="sec-title"><span id="rec-t1"></span> <em id="rec-t2"></em></h2>
      <div class="divider"></div>
    </div>
    <ul class="bonus-list" id="recursos-list"></ul>
  </section>

  <section class="instr">
    <div class="sec-hd">
      <span class="sec-eye" id="ins-eye"></span>
      <h2 class="sec-title"><span id="ins-t1"></span> <em id="ins-t2"></em></h2>
      <div class="divider"></div>
    </div>
    <div class="instr-card">
      <div id="instr-photo-wrap"><div class="instr-photo-placeholder">👩</div></div>
      <div class="instr-name" id="instr-name"></div>
      <div class="instr-role" id="instr-role"></div>
      <p class="instr-bio" id="instr-bio1"></p>
      <p class="instr-bio" id="instr-bio2"></p>
      <p class="instr-bio" id="instr-bio3"></p>
      <span class="certs-label">Certificaciones</span>
      <div class="cert-tags" id="cert-tags"></div>
    </div>
  </section>

  <section class="sec">
    <div class="sec-hd">
      <span class="sec-eye" id="mod2-eye"></span>
      <h2 class="sec-title"><span id="mod2-t1"></span> <em id="mod2-t2"></em></h2>
      <div class="divider"></div>
    </div>
    <div class="modes-grid" id="modes-grid"></div>
  </section>

  <section class="pricing" id="pricing-sec">
    <span class="sec-eye" id="price-eye"></span>
    <h2 class="sec-title"><span id="price-t1"></span> <em id="price-t2"></em></h2>
    <div class="divider"></div>
    <div class="price-card">
      <div class="pbadge" id="pbadge"></div>
      <div class="pamt"><sup class="curr" id="psym"></sup><span id="pmonto"></span><sup class="cents" id="pcents"></sup></div>
      <div class="pper" id="pper"></div>
      <div class="pdiv"></div>
      <ul class="pfeats" id="pfeats"></ul>
      <button class="btn-p" id="buy-btn" style="margin-bottom:0;" onclick="handleBuy()"></button>
      <p class="guar" id="pguar"></p>
    </div>
  </section>

  <section class="faq">
    <div class="sec-hd">
      <span class="sec-eye" id="faq-eye"></span>
      <h2 class="sec-title"><span id="faq-t1"></span> <em id="faq-t2"></em></h2>
      <div class="divider"></div>
    </div>
    <div id="faq-list"></div>
  </section>

  <footer class="footer">
    <div class="fl" id="footer-logo"></div>
    <div class="ft" id="footer-tag"></div>
  </footer>

</div>

<script>
const CSV_ID = "2PACX-1vTNrBlClx7RaUvutzy7ZpvpkejViZ4mvzALF1TLAbb9hUiE3PP6DS9Y_NgnY4M3Ibb1ElZpicsMhSXB";
const CSV_GID = "1487504840";
const CSV_DIRECT = `https://docs.google.com/spreadsheets/d/e/${CSV_ID}/pub?gid=${CSV_GID}0026single=true0026output=csv`;
const CSV_PROXY1 = `https://corsproxy.io/?${encodeURIComponent(CSV_DIRECT)}`;
const CSV_PROXY2 = `https://api.allorigins.win/raw?url=${encodeURIComponent(CSV_DIRECT)}`;
let BUY_LINK = "#";

function splitCSVLine(line) {
  const res = []; let cur = '', inQ = false;
  for (let i = 0; i < line.length; i++) {
    const c = line[i];
    if (c === '"') { inQ = !inQ; continue; }
    if (c === ',' && !inQ) { res.push(cur.trim()); cur = ''; continue; }
    cur += c;
  }
  res.push(cur.trim());
  return res;
}

function parseCSV(text) {
  const data = {};
  for (const line of text.split('\n')) {
    const cols = splitCSVLine(line);
    if (!cols || cols.length < 2) continue;
    const sec = cols[0] || '';
    const campo = cols[1] || '';
    const valor = cols[2] || '';
    const link  = cols[3] || '';
    if (!sec || !campo || sec.startsWith('==') || sec === 'SECCION') continue;
    data[sec + '|' + campo] = { valor, link };
  }
  return data;
}

function g(data, sec, campo)     { const e = data[sec+'|'+campo]; return e ? e.valor : ''; }
function gl(data, sec, campo)    { const e = data[sec+'|'+campo]; return e ? e.link  : ''; }
function set(id, val)            { const e = document.getElementById(id); if (e && val) e.textContent = val; }
function goTo(id)                { const e = document.getElementById(id); if (e) e.scrollIntoView({behavior:'smooth'}); }
function handleBuy()             { if (BUY_LINK !== '#') window.open(BUY_LINK,'_blank'); else goTo('pricing-sec'); }
function isPlaceholder(s)        { return !s || s.includes('PON AQUI') || s.includes('tu-link'); }

function tog(btn) {
  const a = btn.nextElementSibling;
  const arr = btn.querySelector('.arr');
  const open = a.classList.toggle('open');
  btn.classList.toggle('open', open);
  arr.textContent = open ? '－' : '＋';
}

function buildPage(data) {

  // BANNER
  const bLink = gl(data,'BANNER','imagen_banner');
  const bw = document.getElementById('banner-wrap');
  if (!isPlaceholder(bLink)) {
    bw.innerHTML = `<img src="${bLink}" alt="Banner" style="width:100%;height:100%;object-fit:cover;object-position:center 20%;"/>
    <div class="banner-overlay"></div>
    <div class="banner-logo">
      <div class="banner-logo-text">${g(data,'BANNER','logo_sobre_banner')}</div>
      <span class="banner-logo-sub">${g(data,'BANNER','subtitulo_banner')}</span>
    </div>`;
  } else {
    set('banner-logo-display',   g(data,'BANNER','logo_sobre_banner') || 'JM Skills Academy');
    set('banner-sub-display',    g(data,'BANNER','subtitulo_banner')  || 'Academia Profesional de Lashes');
    set('banner-fallback-text',  g(data,'BANNER','logo_sobre_banner') || 'JM Skills Academy');
  }

  // NAV
  set('nav-logo', g(data,'NAVEGACION','logo_texto'));
  set('nav-btn',  g(data,'NAVEGACION','boton_texto'));

  // HERO
  set('hero-eyebrow', g(data,'HERO','eyebrow_texto'));
  set('hero-t1',      g(data,'HERO','titulo_linea1'));
  set('hero-t2',      g(data,'HERO','titulo_linea2'));
  set('hero-sub',     g(data,'HERO','subtitulo'));
  set('btn-main',     g(data,'HERO','boton_principal'));
  set('btn-sec',      g(data,'HERO','boton_secundario'));
  const pw = document.getElementById('pills-wrap');
  ['pill_1','pill_2','pill_3'].forEach(p => {
    const v = g(data,'HERO',p);
    if (v) pw.innerHTML += `<span class="pill">${v}</span>`;
  });

  // STATS
  set('s1n', g(data,'ESTADISTICAS','stat1_numero'));
  set('s1l', g(data,'ESTADISTICAS','stat1_label'));
  set('s2n', g(data,'ESTADISTICAS','stat2_numero'));
  set('s2l', g(data,'ESTADISTICAS','stat2_label'));
  set('s3n', g(data,'ESTADISTICAS','stat3_numero'));
  set('s3l', g(data,'ESTADISTICAS','stat3_label'));
  const s4 = g(data,'ESTADISTICAS','stat4_numero');
  set('s4n', s4 === 'inf' ? '∞' : (s4 || '∞'));
  set('s4l', g(data,'ESTADISTICAS','stat4_label'));

  // MODULOS TITULO
  set('mod-eye', g(data,'MODULOS_TITULO','eyebrow'));
  set('mod-t1',  g(data,'MODULOS_TITULO','titulo_parte1'));
  set('mod-t2',  g(data,'MODULOS_TITULO','titulo_parte2'));

  // MODULOS GRID
  const mg = document.getElementById('mod-grid');
  mg.innerHTML = '';
  const fallbackEmoji = ['💎','🎨','🛡️','👑','💰','📲'];
  for (let i = 1; i <= 6; i++) {
    const sec   = 'MODULO_' + i;
    const img   = gl(data, sec, 'imagen');
    const titulo = g(data, sec, 'titulo');
    const desc   = g(data, sec, 'descripcion');
    const imgHTML = !isPlaceholder(img)
      ? `<img src="${img}" alt="${titulo}" loading="lazy"/>`
      : `<div class="mod-img-placeholder">${fallbackEmoji[i-1]}</div>`;
    mg.innerHTML += `
      <div class="mod-item">
        <div class="mod-img-wrap">${imgHTML}</div>
        <div class="mod-info">
          <div class="mod-t">${titulo}</div>
          <div class="mod-d">${desc}</div>
        </div>
      </div>`;
  }

  // RECURSOS
  set('rec-eye', g(data,'RECURSOS_TITULO','eyebrow'));
  set('rec-t1',  g(data,'RECURSOS_TITULO','titulo_parte1'));
  set('rec-t2',  g(data,'RECURSOS_TITULO','titulo_parte2'));
  const rl = document.getElementById('recursos-list');
  rl.innerHTML = '';
  for (let i = 1; i <= 10; i++) {
    const t = g(data,'RECURSO_'+i,'texto');
    if (t) rl.innerHTML += `<li><span class="bc">✦</span>${t}</li>`;
  }

  // INSTRUCTORA TITULO
  set('ins-eye', g(data,'INSTRUCTORA_TITULO','eyebrow'));
  set('ins-t1',  g(data,'INSTRUCTORA_TITULO','titulo_parte1'));
  set('ins-t2',  g(data,'INSTRUCTORA_TITULO','titulo_parte2'));

  // INSTRUCTORA
  const fLink = gl(data,'INSTRUCTORA','foto');
  if (!isPlaceholder(fLink)) {
    document.getElementById('instr-photo-wrap').innerHTML =
      `<img class="instr-photo" src="${fLink}" alt="Jennyfer Montilla"/>`;
  }
  set('instr-name', g(data,'INSTRUCTORA','nombre'));
  set('instr-role', g(data,'INSTRUCTORA','rol'));
  set('instr-bio1', g(data,'INSTRUCTORA','bio_1'));
  set('instr-bio2', g(data,'INSTRUCTORA','bio_2'));
  set('instr-bio3', g(data,'INSTRUCTORA','bio_3'));
  const ct = document.getElementById('cert-tags');
  ct.innerHTML = '';
  for (let i = 1; i <= 8; i++) {
    const c = g(data,'CERTIFICACION_'+i,'texto');
    if (c) ct.innerHTML += `<span class="ctag">${c}</span>`;
  }

  // MODALIDAD
  set('mod2-eye', g(data,'MODALIDAD_TITULO','eyebrow'));
  set('mod2-t1',  g(data,'MODALIDAD_TITULO','titulo_parte1'));
  set('mod2-t2',  g(data,'MODALIDAD_TITULO','titulo_parte2'));
  const mog = document.getElementById('modes-grid');
  mog.innerHTML = '';
  for (let i = 1; i <= 4; i++) {
    const s = 'MODALIDAD_'+i;
    mog.innerHTML += `<div class="mode">
      <span class="me">${g(data,s,'emoji')}</span>
      <span class="ml">${g(data,s,'titulo')}</span>
      <span class="ms">${g(data,s,'subtitulo')}</span>
    </div>`;
  }

  // PRECIO
  set('price-eye', g(data,'PRECIO_TITULO','eyebrow'));
  set('price-t1',  g(data,'PRECIO_TITULO','titulo_parte1'));
  set('price-t2',  g(data,'PRECIO_TITULO','titulo_parte2'));
  set('pbadge',    g(data,'PRECIO','badge_texto'));
  set('psym',      g(data,'PRECIO','simbolo'));
  set('pmonto',    g(data,'PRECIO','monto'));
  set('pcents',    g(data,'PRECIO','centavos'));
  set('pper',      g(data,'PRECIO','periodo_texto'));
  set('pguar',     g(data,'PRECIO','garantia_texto'));
  set('buy-btn',   g(data,'PRECIO','boton_texto'));
  const lnk = g(data,'PRECIO','link_compra');
  if (!isPlaceholder(lnk)) BUY_LINK = lnk;
  const pf = document.getElementById('pfeats');
  pf.innerHTML = '';
  for (let i = 1; i <= 8; i++) {
    const f = g(data,'PRECIO','feature_'+i);
    if (f) pf.innerHTML += `<li><span class="pchk">✦</span>${f}</li>`;
  }

  // FAQ
  set('faq-eye', g(data,'FAQ_TITULO','eyebrow'));
  set('faq-t1',  g(data,'FAQ_TITULO','titulo_parte1'));
  set('faq-t2',  g(data,'FAQ_TITULO','titulo_parte2'));
  const fl = document.getElementById('faq-list');
  fl.innerHTML = '';
  for (let i = 1; i <= 8; i++) {
    const q = g(data,'FAQ_'+i,'pregunta');
    const a = g(data,'FAQ_'+i,'respuesta');
    if (q && a) fl.innerHTML += `
      <div class="faq-item">
        <button class="faq-q" onclick="tog(this)">${q}<span class="arr">＋</span></button>
        <div class="faq-a">${a}</div>
      </div>`;
  }

  // FOOTER
  set('footer-logo', g(data,'FOOTER','logo_texto'));
  set('footer-tag',  g(data,'FOOTER','tagline'));
}

async function fetchWithFallback() {
  const urls = [CSV_PROXY1, CSV_PROXY2, CSV_DIRECT];
  for (const url of urls) {
    try {
      const res = await fetch(url);
      if (!res.ok) continue;
      const text = await res.text();
      if (text && text.length > 50) return text;
    } catch(e) {
      continue;
    }
  }
  return null;
}

async function init() {
  try {
    const text = await fetchWithFallback();
    if (text) {
      buildPage(parseCSV(text));
    } else {
      console.warn('No se pudo cargar el CSV — mostrando contenido por defecto.');
    }
  } catch(e) {
    console.error('Error cargando CSV:', e);
  } finally {
    document.getElementById('loading').style.display = 'none';
    document.getElementById('page').style.display = 'block';
  }
}

init();
</script>
